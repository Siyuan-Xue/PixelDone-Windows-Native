<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PixelDone.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PixelDone.Core\PixelDone.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(PIXELDONE_SUPABASE_URL)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PixelDoneSupabaseUrl</_Parameter1>
      <_Parameter2>$(PIXELDONE_SUPABASE_URL)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PixelDoneSupabasePublishableKey</_Parameter1>
      <_Parameter2>$(PIXELDONE_SUPABASE_PUBLISHABLE_KEY)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PixelDoneAllowInsecureHttp</_Parameter1>
      <_Parameter2>$(PIXELDONE_ALLOW_INSECURE_HTTP)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target
    Name="ValidateRequiredCloudConfiguration"
    BeforeTargets="CoreCompile"
    Condition="'$(PIXELDONE_REQUIRE_CLOUD_CONFIG)' == 'true'">
    <Error
      Condition="'$(PIXELDONE_SUPABASE_URL)' == ''"
      Text="PIXELDONE_SUPABASE_URL is required for this build." />
    <Error
      Condition="'$(PIXELDONE_SUPABASE_PUBLISHABLE_KEY)' == ''"
      Text="PIXELDONE_SUPABASE_PUBLISHABLE_KEY is required for this build." />
  </Target>
</Project>
