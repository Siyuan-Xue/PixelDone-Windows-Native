<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PixelDone.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelDone.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="PixelInkColor">#FF131313</Color>
            <Color x:Key="PixelPaperColor">#FFF7F5F0</Color>
            <Color x:Key="PixelPanelColor">#FFFFFFFF</Color>
            <Color x:Key="PixelAccentColor">#FFD97757</Color>
            <Color x:Key="PixelMutedColor">#FF77736C</Color>
            <SolidColorBrush x:Key="PixelInkBrush" Color="{StaticResource PixelInkColor}" />
            <SolidColorBrush x:Key="PixelPaperBrush" Color="{StaticResource PixelPaperColor}" />
            <SolidColorBrush x:Key="PixelPanelBrush" Color="{StaticResource PixelPanelColor}" />
            <SolidColorBrush x:Key="PixelAccentBrush" Color="{StaticResource PixelAccentColor}" />
            <SolidColorBrush x:Key="PixelMutedBrush" Color="{StaticResource PixelMutedColor}" />

            <Style x:Key="PixelButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{StaticResource PixelInkBrush}" />
                <Setter Property="Background" Value="{StaticResource PixelPanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource PixelInkBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="PixelTextBoxStyle" TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{StaticResource PixelInkBrush}" />
                <Setter Property="Background" Value="{StaticResource PixelPanelBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
