<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PixelDone.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelDone.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PixelInkBrush" Color="#FF131313" />
                    <SolidColorBrush x:Key="PixelPaperBrush" Color="#FFF7F5F0" />
                    <SolidColorBrush x:Key="PixelPanelBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PixelAccentBrush" Color="#FFD97757" />
                    <SolidColorBrush x:Key="PixelMutedBrush" Color="#FF77736C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PixelInkBrush" Color="#FFF3EFE7" />
                    <SolidColorBrush x:Key="PixelPaperBrush" Color="#FF181716" />
                    <SolidColorBrush x:Key="PixelPanelBrush" Color="#FF242220" />
                    <SolidColorBrush x:Key="PixelAccentBrush" Color="#FFE58B6E" />
                    <SolidColorBrush x:Key="PixelMutedBrush" Color="#FFB0ACA3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PixelInkBrush" Color="#FF131313" />
                    <SolidColorBrush x:Key="PixelPaperBrush" Color="#FFF7F5F0" />
                    <SolidColorBrush x:Key="PixelPanelBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PixelAccentBrush" Color="#FFD97757" />
                    <SolidColorBrush x:Key="PixelMutedBrush" Color="#FF77736C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PixelButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{ThemeResource PixelInkBrush}" />
                <Setter Property="Background" Value="{ThemeResource PixelPanelBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PixelInkBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="14,8" />
            </Style>

            <Style x:Key="PixelTextBoxStyle" TargetType="TextBox">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="BorderBrush" Value="{ThemeResource PixelInkBrush}" />
                <Setter Property="Background" Value="{ThemeResource PixelPanelBrush}" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
