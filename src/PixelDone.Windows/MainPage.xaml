<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelDone.Windows.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PixelDone.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource PixelPaperBrush}"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Padding="24"
            Background="{StaticResource PixelInkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="PIXELDONE" />
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        Foreground="{StaticResource PixelAccentBrush}"
                        Text="WINDOWS · NATIVE 4.0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="10">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="{StaticResource PixelAccentBrush}"
                        BorderBrush="White"
                        BorderThickness="2"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PixelInkBrush}"
                        Content="■  MAIN" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderBrush="#FF555555"
                        BorderThickness="2"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono"
                        Foreground="White"
                        IsEnabled="False"
                        Content="□  TRASH · NEXT" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderBrush="#FF555555"
                        BorderThickness="2"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono"
                        Foreground="White"
                        IsEnabled="False"
                        Content="□  SETTINGS · NEXT" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <Rectangle Height="2" Fill="#FF555555" />
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        Foreground="#FFBBBBBB"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="10"
                        Foreground="#FF777777"
                        Text="SCHEMA 3.2 · LOCAL FIRST" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Padding="32,26,32,32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontFamily="Cascadia Mono"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource PixelInkBrush}"
                        Text="TODAY" />
                    <TextBlock
                        Margin="1,2,0,0"
                        FontFamily="Cascadia Mono"
                        FontSize="11"
                        Foreground="{StaticResource PixelMutedBrush}"
                        Text="{Binding OpenCountLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <ToggleSwitch
                        Header="HIDE DONE"
                        FontFamily="Cascadia Mono"
                        IsOn="{Binding HideCompleted, Mode=TwoWay}" />
                    <ComboBox
                        Width="130"
                        Header="SORT"
                        CornerRadius="0"
                        FontFamily="Cascadia Mono"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SortMode, Mode=TwoWay}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="NewTodoTextBox"
                    PlaceholderText="WHAT NEEDS TO BE DONE?"
                    Style="{StaticResource PixelTextBoxStyle}"
                    Text="{Binding NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="NewTodoTextBox_KeyDown" />
                <ComboBox
                    Grid.Column="1"
                    CornerRadius="0"
                    FontFamily="Cascadia Mono"
                    ItemsSource="{Binding Priorities}"
                    SelectedItem="{Binding NewPriority, Mode=TwoWay}" />
                <Button
                    Grid.Column="2"
                    Style="{StaticResource PixelButtonStyle}"
                    Background="{StaticResource PixelAccentBrush}"
                    Click="AddTodo_Click"
                    Content="+ ADD" />
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="420" />
                    <ColumnDefinition Width="2*" MinWidth="310" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{StaticResource PixelPanelBrush}"
                    BorderBrush="{StaticResource PixelInkBrush}"
                    BorderThickness="2">
                    <Grid>
                        <ListView
                            ItemsSource="{Binding Todos}"
                            SelectedItem="{Binding SelectedTodo, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="CornerRadius" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        MinHeight="72"
                                        Padding="16,10"
                                        BorderBrush="#FFE1DDD4"
                                        BorderThickness="0,0,0,1"
                                        ColumnSpacing="12"
                                        Opacity="{Binding ContentOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource PixelInkBrush}"
                                            BorderThickness="2"
                                            CornerRadius="0"
                                            FontWeight="Bold"
                                            Content="{Binding CompletionGlyph}"
                                            Click="ToggleTodo_Click" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock
                                                FontFamily="Cascadia Mono"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PixelInkBrush}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontFamily="Cascadia Mono"
                                                    FontSize="10"
                                                    Foreground="{StaticResource PixelMutedBrush}"
                                                    Text="{Binding DueDisplay}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono"
                                                    FontSize="10"
                                                    Foreground="{StaticResource PixelMutedBrush}"
                                                    Text="{Binding RepeatDisplay}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border
                                            Grid.Column="2"
                                            Padding="7,3"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource PixelPaperBrush}"
                                            BorderBrush="{StaticResource PixelInkBrush}"
                                            BorderThickness="1">
                                            <TextBlock
                                                FontFamily="Cascadia Mono"
                                                FontSize="9"
                                                FontWeight="Bold"
                                                Text="{Binding PriorityLabel}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="20"
                    Background="#FFFFFCF5"
                    BorderBrush="{StaticResource PixelInkBrush}"
                    BorderThickness="2">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontFamily="Cascadia Mono"
                            FontSize="17"
                            FontWeight="Bold"
                            Text="TASK INSPECTOR" />
                        <Rectangle Height="2" Fill="{StaticResource PixelInkBrush}" />
                        <TextBlock
                            FontFamily="Cascadia Mono"
                            FontSize="10"
                            Foreground="{StaticResource PixelMutedBrush}"
                            Text="SELECT A TASK TO EDIT" />
                        <TextBox
                            Header="TITLE"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource PixelTextBoxStyle}"
                            Text="{Binding EditorTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            Header="PRIORITY"
                            CornerRadius="0"
                            FontFamily="Cascadia Mono"
                            IsEnabled="{Binding HasSelection}"
                            ItemsSource="{Binding Priorities}"
                            SelectedItem="{Binding EditorPriority, Mode=TwoWay}" />
                        <DatePicker
                            Header="DUE DATE"
                            CornerRadius="0"
                            FontFamily="Cascadia Mono"
                            IsEnabled="{Binding HasSelection}"
                            Date="{Binding EditorDueDate, Mode=TwoWay}" />
                        <TimePicker
                            Header="DUE TIME"
                            CornerRadius="0"
                            FontFamily="Cascadia Mono"
                            IsEnabled="{Binding HasSelection}"
                            Time="{Binding EditorDueTime, Mode=TwoWay}" />
                        <ComboBox
                            Header="REPEAT"
                            CornerRadius="0"
                            FontFamily="Cascadia Mono"
                            IsEnabled="{Binding HasSelection}"
                            ItemsSource="{Binding RepeatOptions}"
                            SelectedItem="{Binding EditorRepeat, Mode=TwoWay}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource PixelButtonStyle}"
                            Background="{StaticResource PixelAccentBrush}"
                            Click="SaveTodo_Click"
                            Content="SAVE CHANGES" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource PixelButtonStyle}"
                            Click="DeleteTodo_Click"
                            Content="DELETE" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
